# server
SERVER_PORT=50620
INSTANCE_ID=1
TOTAL_INSTANCES=4

# database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mobinogi
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# google api
GOOGLE_SHEETS_CREDENTIALS_PATH=google-oauth/credentials.json
GOOGLE_SHEETS_ID=your_google_sheets_id

# Notion API
NOTION_API_TOKEN=secret_your_notion_integration_token
NOTION_PAGE_ID=your_parent_page_id
NOTION_SYNC_ENABLED=true

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_TEXT_CHANNEL_IDS=channel_id_1,channel_id_2
DISCORD_FORUM_CHANNEL_IDS=forum_channel_id_1

# App URL
APP_URL=http://localhost:3000

# JWT
JWT_SECRET=your-very-secure-256-bit-secret-key-here-make-it-long
JWT_EXPIRATION=86400000

# frontend (Vite)
VITE_APP_TITLE=Mobinogi-Dev
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:50621
VITE_API_PREFIX=/api
# IMPORTANT: Register http://localhost:3000 in Kakao Developers > Platform > Web.
VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=localhost
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_SOURCEMAP=true
VITE_ENABLE_DEBUG_LOGS=true
VITE_WEBSOCKET_URL=ws://localhost:50621/ws
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_BUILD_MINIFY=false
VITE_BUILD_CHUNK_SIZE_WARNING_LIMIT=1000
VITE_API_URL=http://localhost:50621
