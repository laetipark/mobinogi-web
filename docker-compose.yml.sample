services:
    # Nginx Reverse Proxy
    nginx:
        image: nginx:alpine
        container_name: nginx-proxy
        ports:
            - "80:80"
        volumes:
            - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
        depends_on:
            - app
            - frontend
        restart: unless-stopped
        networks:
            - mobinogi-network

    # Spring Boot Backend
    app:
        image: eclipse-temurin:21-jdk
        container_name: spring-boot-app
        expose:
            - "50620"
        volumes:
            - ./target:/app
            - ./credentials:/app/credentials:ro
        working_dir: /app
        command: ["java", "-Xms512m", "-Xmx1024m", "-jar", "mobinogi-web-0.0.1.war"]
        environment:
            SERVER_PORT: 50620
            TZ: Asia/Seoul
        env_file:
            - .env
        restart: unless-stopped
        networks:
            - mobinogi-network
        healthcheck:
            test: ["CMD", "curl", "-f", "http://localhost:50620/actuator/health"]
            interval: 10m
            timeout: 30s
            retries: 3
            start_period: 30s

    # React Frontend (Production Build)
    frontend:
        image: node:18-alpine
        container_name: react-frontend
        working_dir: /app
        expose:
            - "3000"
        volumes:
            - ./frontend:/app
            - frontend_node_modules:/app/node_modules
        environment:
            - VITE_APP_TITLE=Mobinogi
            - VITE_APP_ENV=production
            - VITE_SERVER_PORT=3000
            - VITE_SERVER_HOST=0.0.0.0
        command: sh -c "npm install && npm run build && npm run preview:prod"
        depends_on:
            - app
        restart: unless-stopped
        networks:
            - mobinogi-network

    # Redis Cache
    redis:
        image: redis:alpine
        container_name: redis-cache
        expose:
            - "6379"
        restart: unless-stopped
        command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
        volumes:
            - redis-data:/data
        networks:
            - mobinogi-network

networks:
    mobinogi-network:
        driver: bridge

volumes:
    redis-data:
        driver: local
    frontend_node_modules:
        driver: local
