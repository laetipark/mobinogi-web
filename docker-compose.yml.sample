services:
    # Nginx Reverse Proxy
    nginx:
        image: nginx:alpine
        container_name: nginx-proxy
        ports:
            - "80:80"
        volumes:
            - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
        depends_on:
            - app
        restart: unless-stopped
        networks:
            - mobinogi-network

    # Spring Boot App Image
    app:
        image: ${APP_IMAGE:-mobinogi-web:latest}
        build:
            context: .
            dockerfile: Dockerfile
        pull_policy: ${APP_PULL_POLICY:-never}
        container_name: spring-boot-app
        expose:
            - "50620"
        volumes:
            - ./credentials:/app/credentials:ro
        environment:
            SERVER_PORT: 50620
            TZ: Asia/Seoul
        env_file:
            - .env
        restart: unless-stopped
        networks:
            - mobinogi-network
        healthcheck:
            test: ["CMD", "curl", "-f", "http://localhost:50620/actuator/health"]
            interval: 10m
            timeout: 30s
            retries: 3
            start_period: 30s

networks:
    mobinogi-network:
        driver: bridge
