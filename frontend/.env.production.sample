# App Configuration
VITE_APP_TITLE=Mobinogi
VITE_APP_ENV=production

# API Configuration (프로덕션에서는 상대 경로 사용)
VITE_API_BASE_URL=
VITE_API_PREFIX=/api

# Kakao API Configuration (Production)
# 프로덕션용 Kakao JavaScript 키를 입력하세요
VITE_KAKAO_JS_KEY=your_production_kakao_javascript_key_here
VITE_KAKAO_REDIRECT_URI=https://yourdomain.com/auth/kakao/callback

# Production Features
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_SOURCEMAP=false
VITE_ENABLE_DEBUG_LOGS=false

# WebSocket Configuration (Production)
# 실제 프로덕션 도메인으로 변경하세요
VITE_WEBSOCKET_URL=wss://yourdomain.com/ws

# External Services (Production)
# Google Analytics ID를 입력하세요
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# Sentry DSN을 입력하세요 (에러 추적용)
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Build Optimization
VITE_BUILD_MINIFY=true
VITE_BUILD_CHUNK_SIZE_WARNING_LIMIT=500

# Security Configuration
VITE_SECURE_MODE=true