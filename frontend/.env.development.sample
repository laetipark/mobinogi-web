# ===========================
# 개발 환경 설정 (Frontend)
# ===========================

# App Configuration
VITE_APP_TITLE=Mobinogi-Dev
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:50621
VITE_API_PREFIX=/api

# Kakao API Configuration (Development)
VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# Development Server Configuration
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=localhost

# Development Features
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_SOURCEMAP=true
VITE_ENABLE_DEBUG_LOGS=true

# WebSocket Configuration
VITE_WEBSOCKET_URL=ws://localhost:50621/ws

# External Services (Development)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Build Configuration
VITE_BUILD_MINIFY=false
VITE_BUILD_CHUNK_SIZE_WARNING_LIMIT=1000
